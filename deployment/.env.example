# Copy to .env on the server, set real values there, and keep it out of Git.
# Values must be URL-encoded when they are inserted into an RTSP URL.
FRIGATE_MQTT_HOST=192.168.0.169
FRIGATE_MQTT_USER=replace-me
FRIGATE_MQTT_PASSWORD=replace-me
FRIGATE_ENTRANCE_RTSP_USER=replace-me
FRIGATE_ENTRANCE_RTSP_PASSWORD=replace-me
FRIGATE_GF_RTSP_USER=replace-me
FRIGATE_GF_RTSP_PASSWORD=replace-me
